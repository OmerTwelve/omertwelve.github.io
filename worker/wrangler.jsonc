{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omertwelve-github-io",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-19",
  "vars": {
    "ALLOWED_ORIGINS": "https://omertwelve.github.io,http://localhost:4321,http://127.0.0.1:4321",
    "DEEPSEEK_MODEL": "deepseek-flash",
    "RATE_PER_MINUTE": "6",
    "RATE_PER_DAY": "60",
    "GLOBAL_PER_DAY": "400",
    "DEEPSEEK_PRICE_IN_PER_M": "0.30",
    "DEEPSEEK_PRICE_OUT_PER_M": "1.20"
  },
  "durable_objects": {
    "bindings": [{ "name": "LIMITER", "class_name": "Quota" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Quota"] }]
}
