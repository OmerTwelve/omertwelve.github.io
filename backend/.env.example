# Copy to .env and fill in. Never commit .env — it is gitignored.
DEEPSEEK_API_KEY=

# Optional overrides (defaults shown in config.py)
# DeepSeek model. `deepseek-flash` is the current documented name; the old
# `deepseek-chat` still works but is an undocumented legacy alias.
# DEEPSEEK_MODEL=deepseek-flash

# Thinking is OFF by default: reasoning tokens count against MAX_TOKENS and can
# leave the answer EMPTY (measured), and it is slower for no gain on grounded Q&A.
# DEEPSEEK_THINKING=false
# DEEPSEEK_TEMPERATURE=0.3

# Cost-meter prices, USD per million tokens (deepseek-flash peak / cache-miss).
# Verify against DeepSeek's pricing page — they change, and off-peak is half.
# DEEPSEEK_PRICE_IN_PER_M=0.30
# DEEPSEEK_PRICE_OUT_PER_M=1.20
# ALLOWED_ORIGINS=https://omertwelve.github.io
# RATE_PER_MINUTE=6
# RATE_PER_DAY=60

# Ceiling on total requests per day across ALL visitors — your worst-case spend
# is roughly this times the cost of one answer (see the usage meter).
# GLOBAL_PER_DAY=400

# Which header carries the real client IP. LEAVE EMPTY unless the backend is
# reachable ONLY through a proxy that sets it (e.g. cf-connecting-ip behind a
# Cloudflare tunnel). Trusting a header an attacker can set defeats the limiter.
# CLIENT_IP_HEADER=cf-connecting-ip
